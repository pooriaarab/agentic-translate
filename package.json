{
  "name": "agentic-translate",
  "version": "0.1.1",
  "description": "Translate text with DeepL, OpenAI, and Cloudflare Workers AI through a CLI, MCP server, or agent library.",
  "keywords": [
    "deepl",
    "openai",
    "cloudflare-workers-ai",
    "translation",
    "text-translation",
    "machine-translation",
    "typescript",
    "nodejs",
    "cli",
    "mcp",
    "language",
    "dry-run"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "https://github.com/pooriaarab/agentic-translate.git"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-translate",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agentic-translate": "./dist/cli.js",
    "agentic-translate-mcp": "./dist/mcp-bin.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
